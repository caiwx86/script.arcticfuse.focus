<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<addon id="script.arcticfuse.focus" name="Arctic Fuse Focus" version="1.5.0" provider-name="caiwx86">
    <requires>
        <import addon="xbmc.python" version="3.0.0"/>
    </requires>
    <extension point="xbmc.python.script" library="default.py">
        <provides>executable</provides>
    </extension>
    <extension point="xbmc.addon.metadata">
        <summary lang="en_GB">Focus helper for Arctic Fuse 3</summary>
        <summary lang="zh">Arctic Fuse 3 焦点助手</summary>
        <description lang="en_GB">Focuses the currently playing or last played episode in the OSD playlist and poster wall of the Arctic Fuse 3 skin.</description>
        <description lang="zh">在 OSD 播放列表与海报墙中定位当前/上次播放的剧集。</description>
        <platform>all</platform>
        <license>MIT</license>
        <source>https://github.com/caiwx86/script.arcticfuse.focus</source>
    </extension>
</addon>
